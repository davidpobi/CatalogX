# Browser-safe Firebase configuration
NEXT_PUBLIC_FIREBASE_PUBLIC_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_PUBLIC_AUTH_DOMAIN=replace-me
NEXT_PUBLIC_FIREBASE_PUBLIC_PROJECT_ID=replace-me
NEXT_PUBLIC_FIREBASE_PUBLIC_STORAGE_BUCKET=replace-me
NEXT_PUBLIC_FIREBASE_PUBLIC_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_PUBLIC_APP_ID=replace-me
NEXT_PUBLIC_FIREBASE_PUBLIC_MEASUREMENT_ID=replace-me

# Server-only Firebase service-account credentials. Keep the private key on one line with escaped newlines.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@replace-me.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
OPENAI_API_KEY=replace-me
REPLICATE_API_TOKEN=replace-me
RATE_LIMIT_SALT=replace-with-a-random-value
# Optional locally. Production defaults to Firestore when this is omitted.
# RATE_LIMIT_REPOSITORY=memory
CATALOG_REPOSITORY=json
